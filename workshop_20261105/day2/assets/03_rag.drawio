<mxfile host="drawio"><diagram name="L03｜RAG：問題、片段與可驗證的引用"><mxGraphModel page="1" pageWidth="1260" pageHeight="660"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="L03｜RAG：問題、片段與可驗證的引用" parent="1" vertex="1" style="text;strokeColor=none;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="15" width="1190" height="55" as="geometry" /></mxCell><mxCell id="state" value="State 工作紀錄：question 問題 → rows 片段 → report 回答 → validation 引用檢查&#10;詞彙檢索，不使用 embedding；引用的事實支持程度仍由人核對。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="85" width="1190" height="100" as="geometry" /></mxCell><mxCell id="start" value="START&#10;交辦問題" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="250" width="210" height="105" as="geometry" /></mxCell><mxCell id="retrieve" value="retrieve 檢索&#10;排除桌機／未核實線索" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="265" y="250" width="210" height="105" as="geometry" /></mxCell><mxCell id="answer" value="answer 模型回答&#10;只依本次片段" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="510" y="250" width="210" height="105" as="geometry" /></mxCell><mxCell id="check" value="check 檢查&#10;引用 ID 存在嗎？" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="755" y="250" width="210" height="105" as="geometry" /></mxCell><mxCell id="end" value="END&#10;答案＋缺口＋來源" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="1000" y="250" width="210" height="105" as="geometry" /></mxCell><mxCell id="e0" value="" parent="1" edge="1" source="start" target="retrieve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e1" value="" parent="1" edge="1" source="retrieve" target="answer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e2" value="" parent="1" edge="1" source="answer" target="check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e3" value="存在不等於支持結論" parent="1" edge="1" source="check" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="boundary" value="真實公開來源 + 教學採購需求｜官網規格 ≠ 台灣指定 SKU／報價／服務權益&#10;不確定就留下供應商問題。完整步驟與驗收請看圖下方。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="510" width="1190" height="80" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>