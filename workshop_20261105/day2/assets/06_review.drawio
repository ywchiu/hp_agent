<mxfile host="drawio"><diagram name="L06｜來源觀察、兩週比較與人工審核"><mxGraphModel page="1" pageWidth="1260" pageHeight="860"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="L06｜來源觀察、兩週比較與人工審核" parent="1" vertex="1" style="text;strokeColor=none;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="15" width="1190" height="55" as="geometry" /></mxCell><mxCell id="state" value="State 工作紀錄：流程外：真實PDF快照與歷史；教學模擬報價比較（兩者分開標示）&#10;LangGraph：draft 含來源／比較附件、decision 決定、receipt 回執；版本改變需重新審核。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="85" width="1190" height="100" as="geometry" /></mxCell><mxCell id="draft" value="模型產生 RFQ&#10;台灣120台詢價草稿" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="440" width="210" height="105" as="geometry" /></mxCell><mxCell id="review" value="review / interrupt&#10;暫停等候人工決定" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="265" y="440" width="210" height="105" as="geometry" /></mxCell><mxCell id="decision" value="人工選擇&#10;等待／修改&#10;核准／駁回" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="510" y="440" width="210" height="105" as="geometry" /></mxCell><mxCell id="archive" value="archive 或 END&#10;核准存本機；駁回結束" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="755" y="440" width="210" height="105" as="geometry" /></mxCell><mxCell id="end" value="END&#10;回執 sent=False" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="1000" y="440" width="210" height="105" as="geometry" /></mxCell><mxCell id="e0" value="" parent="1" edge="1" source="draft" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e1" value="" parent="1" edge="1" source="review" target="decision" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e2" value="核准／駁回" parent="1" edge="1" source="decision" target="archive" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e3" value="" parent="1" edge="1" source="archive" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" y="-65" as="geometry" /></mxCell><mxCell id="e4" value="修改 → 新指紋 → 重新審核" parent="1" edge="1" source="decision" target="review" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=1;"><mxGeometry relative="1" y="0" as="geometry"><Array as="points"><mxPoint x="615" y="625" /><mxPoint x="370" y="625" /></Array></mxGeometry></mxCell><mxCell id="boundary" value="價格40,000 → 34,000為教學模擬，非真實報價；PDF改動不等於降價。&#10;三種獨立分支演練：核准1筆／改稿再審1筆／駁回0筆；重跑不增加，實際寄送皆0。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="690" width="1190" height="80" as="geometry" /></mxCell><mxCell id="live" value="真實官方PDF觀察&#10;時間、指紋、有效基準&#10;失敗不覆蓋；不推定價格" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="20" y="225" width="270" height="110" as="geometry" /></mxCell><mxCell id="weeks" value="兩週教學模擬報價&#10;先對齊SKU／市場／稅別&#10;再計算變動率與門檻" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="345" y="225" width="270" height="110" as="geometry" /></mxCell><mxCell id="route" value="比較規則判定（流程外）&#10;重大變化 → 進入待審&#10;條件不符／資料不足 → 補查" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="670" y="225" width="300" height="110" as="geometry" /></mxCell><mxCell id="record" value="無重大變化&#10;保留紀錄&#10;不新增待審任務" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=12;"><mxGeometry x="1025" y="225" width="185" height="110" as="geometry" /></mxCell><mxCell id="compare" parent="1" edge="1" source="weeks" target="route" value="" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=15;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="unchanged" parent="1" edge="1" source="route" target="record" value="未達門檻" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=15;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="major" parent="1" edge="1" source="route" target="draft" value="重大變化：建立指定版本的待審任務" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=0;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820" y="390" /><mxPoint x="125" y="390" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>