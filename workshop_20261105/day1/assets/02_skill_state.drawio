<mxfile host="drawio"><diagram name="加入 Skill：流程相同，研究方法可以重複使用"><mxGraphModel page="1" pageWidth="1100" pageHeight="780"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="加入 Skill：流程相同，研究方法可以重複使用" parent="1" vertex="1" style="text;strokeColor=none;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="30" y="15" width="1020" height="60" as="geometry" /></mxCell><mxCell id="state" value="共同狀態 State：問題與對話 messages｜工具紀錄 tool_log｜模型次數 turns｜報告 report&#10;每走完一個節點，就更新這份工作紀錄；本章不示範中斷持久保存。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="30" y="90" width="1020" height="85" as="geometry" /></mxCell><mxCell id="start" value="START&#10;收到研究問題" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="50" y="240" width="180" height="70" as="geometry" /></mxCell><mxCell id="model" value="model 模型&#10;讀問題、證據與規則" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="300" y="230" width="230" height="90" as="geometry" /></mxCell><mxCell id="route" value="接著做什麼？" parent="1" vertex="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="610" y="215" width="190" height="120" as="geometry" /></mxCell><mxCell id="tools" value="tools 工具&#10;查詢教材 JSON，傳回產品資料" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="340" y="410" width="350" height="95" as="geometry" /></mxCell><mxCell id="stop" value="stop 停止&#10;第 6 次仍要求工具：&#10;回報尚未完成" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="825" y="410" width="225" height="100" as="geometry" /></mxCell><mxCell id="end" value="END&#10;交付回答或待確認" parent="1" vertex="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="840" y="230" width="210" height="90" as="geometry" /></mxCell><mxCell id="context" value="SKILL.md → 每次模型節點都會讀取的研究規則（旁路輸入，不是另一個工作節點）。&#10;你改白話規則，同一個問題重跑，核對欄位、未知值與採購問題是否符合新規則。" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#0F172A;fontFamily=PingFang TC;fontSize=18;spacing=10;"><mxGeometry x="50" y="560" width="1000" height="85" as="geometry" /></mxCell><mxCell id="a" value="" parent="1" edge="1" source="start" target="model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="b" value="" parent="1" edge="1" source="model" target="route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c" value="沒有工具要求" parent="1" edge="1" source="route" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="d" value="需要工具，未達 6 次" parent="1" edge="1" source="route" target="tools" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="705" y="455" /></Array></mxGeometry></mxCell><mxCell id="e" value="工具結果寫回對話" parent="1" edge="1" source="tools" target="model" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="457" /><mxPoint x="285" y="360" /><mxPoint x="415" y="360" /></Array></mxGeometry></mxCell><mxCell id="f" value="仍需工具，已達 6 次" parent="1" edge="1" source="route" target="stop" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.8;entryX=0.5;entryY=0;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="935" y="340" /></Array></mxGeometry></mxCell><mxCell id="g" value="" parent="1" edge="1" source="stop" target="end" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;fontFamily=PingFang TC;fontSize=16;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=1;entryY=0.5;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1080" y="460" /><mxPoint x="1080" y="275" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>